# Backend only. Do not copy secret values to the frontend .env.
PORT=5000
TRUST_PROXY=0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
# Frontend browser origin(s), comma separated when needed.
ALLOWED_ORIGIN=http://localhost:5173
# Signing secret from the Clerk webhook endpoint configured in Render.
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional AI assistant. Keep the API key only in this backend file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Non-secret Clerk key used by the Express SDK; also add it to frontend/.env with the VITE_ prefix.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_TELEMETRY_DISABLED=1

# Optional: raise the rate limits for automated test runs only (run-tests.ps1 in the test repo sets these).
# Leave unset in production; the defaults are 120 / 120 / 30 / 20.
# RATE_LIMIT_API=120
# RATE_LIMIT_WEBHOOK=120
# RATE_LIMIT_UPLOAD=30
# RATE_LIMIT_AI=20
