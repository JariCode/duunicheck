# Frontend environment only. Never add Clerk secret keys here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
VITE_CLERK_TELEMETRY_DISABLED=true
VITE_API_URL=http://localhost:5000
VITE_CLERK_PRODUCTION_URL=
VITE_SUPPORT_EMAIL=
# Site root URL with trailing slash, used for the social preview image URL
VITE_SITE_URL=
# Base path for subfolder deployment with slashes, e.g. /duunicheck/ (empty means site root)
VITE_BASE_PATH=