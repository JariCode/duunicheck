# Security headers for the static frontend (requires Apache mod_headers).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Production is served over HTTPS only. No includeSubDomains: other apps are hosted under jaricode.fi.
  Header always set Strict-Transport-Security "max-age=31536000"

  # connect-src allows the backend at https://duunicheck.onrender.com (VITE_API_URL).
  # Clerk sources follow Clerk's CSP guide: the Frontend API host, *.protect.clerk.com
  # (bot protection; connect-src needs the :* port wildcard) and Cloudflare Turnstile.
  # Production uses the Clerk Frontend API domain https://clerk.duunicheck.jaricode.fi.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://clerk.duunicheck.jaricode.fi https://challenges.cloudflare.com https://*.protect.clerk.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://img.clerk.com; connect-src 'self' https://duunicheck.onrender.com https://clerk.duunicheck.jaricode.fi https://*.protect.clerk.com:* https://clerk-telemetry.com; frame-src https://challenges.cloudflare.com https://*.protect.clerk.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Never show a file listing for folders such as assets/ and img/.
Options -Indexes

# The app is served from the domain root. Route every path that has no matching
# file or folder to the frontend entry point, including nested paths such as
# /sign-in/sso-callback.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Browsers and install prompts expect the web app manifest with this MIME type.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>